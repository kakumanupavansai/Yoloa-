DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Exact origins allowed to open the messaging WebSocket (defaults to CSRF_TRUSTED_ORIGINS).
# WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# Real-time messaging: Redis behind the Channels layer (local default below: Redis in Ubuntu/WSL2, no password).
# In production use TLS and a password from the environment, e.g. rediss://:<password>@redis.example.com:6380/0
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_REDIS_PREFIX=yoloa-rate
RATE_LIMIT_REDIS_TIMEOUT=1
# Keep forwarded headers untrusted by default. Configure both values only behind known proxies.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# RATE_LIMIT_TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_ACCOUNT_LIMIT=10
LOGIN_RATE_SOURCE_LIMIT=60
PASSWORD_CHANGE_RATE_LIMIT=5
PASSWORD_CHANGE_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_ACCOUNT_LIMIT=5
PASSWORD_RESET_SOURCE_LIMIT=30
PASSWORD_RESET_RATE_WINDOW_SECONDS=900
MESSAGE_RATE_WINDOW_SECONDS=10
MESSAGE_RATE_LIMIT=20
TYPING_RATE_WINDOW_SECONDS=60
TYPING_RATE_LIMIT=60

# Browser session and CSRF cookies. Keep false only for local HTTP development.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=0
CSRF_COOKIE_SAMESITE=Lax

# PostgreSQL (required; the app has no SQLite fallback). Tests use test_<DB_NAME> on the same server.
DB_NAME=yoloa
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Connection pool (psycopg 3). 1 = on (default); 0 = per-thread persistent connections instead.
DB_POOL=1

# Google OAuth: register this exact callback URL in Google Cloud Console.
# Leave blank to disable Google sign-in until credentials are provisioned.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Production: set DEBUG=False, a fresh 32+ character DJANGO_SECRET_KEY, explicit
# DJANGO_ALLOWED_HOSTS and HTTPS origins, and CHANNEL_REDIS_URL=rediss:// with auth.
# Secure cookies, HTTPS redirect and HSTS default on when DEBUG=False. If TLS ends
# at a trusted reverse proxy, set TRUST_PROXY_SSL_HEADER=1 only when it overwrites
# X-Forwarded-Proto. See DEPLOYMENT_SECURITY.md before deployment.

# Password reset email. Defaults to Django's console backend for local testing.
# Use EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend in deployment.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=YOLOA Learning Portal <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Demo accounts created by `python manage.py seed` (local demonstration only).
DEMO_ADMIN_EMAIL=admin@yoloa.local
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_EMAIL=student@yoloa.local
DEMO_STUDENT_PASSWORD=
